	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Registrar Usuario (con avatar)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set('user_id', jsonData.user.id);",
									"    pm.environment.set('activation_url', jsonData.activationUrl);",
									"    ",
									"    // Extraer token de activación de la URL",
									"    const url = jsonData.activationUrl;",
									"    const token = url.split('/').pop();",
									"    pm.environment.set('activation_token', token);",
									"    ",
									"    console.log('Usuario registrado. URL de activación:', jsonData.activationUrl);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "name",
									"value": "Juan Pérez",
									"type": "text"
								},
								{
									"key": "email",
									"value": "juan.perez@ejemplo.com",
									"type": "text"
								},
								{
									"key": "password",
									"value": "123456",
									"type": "text"
								},
								{
									"key": "bio",
									"value": "Desarrollador Full Stack especializado en Node.js",
									"type": "text"
								},
								{
									"key": "avatar",
									"type": "file",
									"src": "/path/to/avatar.jpg",
									"description": "Imagen de avatar del usuario (JPEG, PNG, GIF, WebP - máx 5MB)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Registra un nuevo usuario con avatar opcional. El usuario se crea inactivo y requiere activación vía enlace."
					},
					"response": []
				},
				{
					"name": "Activar Cuenta de Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    console.log('Cuenta activada exitosamente');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/activate/{{activation_token}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"activate",
								"{{activation_token}}"
							]
						},
						"description": "Activa la cuenta del usuario usando el token de activación obtenido al registrarse."
					},
					"response": []
				},
				{
					"name": "Login Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set('auth_token', jsonData.token);",
									"    pm.environment.set('user_id', jsonData.user.id);",
									"    console.log('Login exitoso. Token guardado.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\\n    \"email\": \"juan.perez@ejemplo.com\",\\n    \"password\": \"123456\"\\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Inicia sesión con email y contraseña. Solo funciona si la cuenta está activada."
					},
					"response": []
				},
				{
					"name": "Obtener Perfil Usuario",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"profile"
							]
						},
						"description": "Obtiene el perfil del usuario autenticado, incluyendo la URL del avatar."
					},
					"response": []
				},
				{
					"name": "Listar Usuarios",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Lista todos los usuarios activos (requiere autenticación)."
					},
					"response": []
				}
			],
			"description": "Endpoints relacionados con autenticación de usuarios, registro con avatar y activación de cuenta."
		},
